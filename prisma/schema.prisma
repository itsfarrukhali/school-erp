generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Enterprise-level School ERP schema
 * - Multi-school, multi-campus
 * - Role + Permission hybrid RBAC
 * - Voucher-first finance flow
 * - Audit logs, background-job friendly
 * - Future-proof modules included
 */

/// ----------------------
/// Core / Identity Models
/// ----------------------

model User {
  id                     String    @id @default(cuid())
  uid                    String    @unique
  username               String    @unique
  firstName              String
  lastName               String
  fullName               String?
  email                  String    @unique
  password               String
  role                   Role      @default(STUDENT)
  gender                 Gender
  dob                    DateTime?
  phoneNo                String?
  designation            String?
  address                Json?
  avatarUrl              String?
  status                 Status    @default(ACTIVE)
  isEmailVerified        Boolean   @default(false)
  verificationCode       String?
  verificationCodeExpiry DateTime?
  lastLogin              DateTime?
  lastLogout             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  // Multi-tenant relations
  schools          UserSchool[]
  campuses         UserCampus[]
  userPermissions  UserPermission[]
  auditLogs        AuditLog[]        @relation("performedBy")
  attendances      Attendance[]
  teacher          Teacher?
  parent           Parent?
  student          Student?
  salaries         Salary[]
  bankDetail       BankDetail?
  schoolAdmin      SchoolAdmin?
  accountant       Accountant?
  admissionOfficer AdmissionOfficer?
  computerOperator ComputerOperator?

  @@index([email])
  @@index([username])
  @@map("users")
}

model School {
  id        String   @id @default(cuid())
  sid       String   @unique
  name      String
  code      String   @unique
  address   Json
  phone     String?
  whatsapp  String?
  email     String?
  website   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campuses              Campus[]
  users                 UserSchool[]
  classes               Class[]
  subjects              Subject[]
  students              Student[]
  feeStructures         FeeStructure[]
  vouchers              Voucher[]
  teachers              Teacher[]
  attendances           Attendance[]
  salaries              Salary[]
  bankDetails           BankDetail[]
  exams                 Exam[]
  timetableSlots        TimetableSlot[]
  libraryItems          LibraryItem[]
  inventoryItems        InventoryItem[]
  transportVehicles     TransportVehicle[]
  transportRoutes       TransportRoute[]
  notifications         Notification[]
  onlineClasses         OnlineClass[]
  schoolAdmins          SchoolAdmin[]
  accountants           Accountant[]
  admissionOfficers     AdmissionOfficer[]
  computerOperators     ComputerOperator[]
  payments              Payment[]
  discountRequests      DiscountRequest[]
  incomingPayments      IncomingPayment[]
  paymentReconciliation PaymentReconciliation[]
  studentAdmissions     StudentAdmission[]
  auditLogs             AuditLog[]

  @@index([code])
  @@index([name])
  @@map("schools")
}

model Campus {
  id         String   @id @default(cuid())
  campusCode String   @unique
  name       String
  address    Json
  phone      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  // Relations
  classes           Class[]
  students          Student[]
  users             UserCampus[]
  teachers          Teacher[]
  attendances       Attendance[]
  vouchers          Voucher[]
  exams             Exam[]
  timetableSlots    TimetableSlot[]
  notifications     Notification[]
  onlineClasses     OnlineClass[]
  permissions       CampusPermission[]
  studentAdmissions StudentAdmission[]

  @@index([schoolId])
  @@index([campusCode])
  @@map("campuses")
}

/// ----------------------
/// Multi-tenant assignment helpers
/// ----------------------

model UserSchool {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  roleForSchool Role
  createdAt     DateTime @default(now())

  @@unique([userId, schoolId])
  @@index([schoolId])
  @@map("user_schools")
}

model UserCampus {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  campusId     String
  campus       Campus   @relation(fields: [campusId], references: [id])
  roleAtCampus Role?
  createdAt    DateTime @default(now())

  @@unique([userId, campusId])
  @@index([campusId])
  @@map("user_campuses")
}

/// ----------------------
/// RBAC: Roles & Permissions (Hybrid)
/// ----------------------

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  allowed      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([role, permissionId])
  @@map("role_permissions")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  label       String
  category    String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions   RolePermission[]
  userPermissions   UserPermission[]
  campusPermissions CampusPermission[]

  @@index([name])
  @@map("permissions")
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  allowed      Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@unique([userId, permissionId])
  @@index([userId])
  @@map("user_permissions")
}

model CampusPermission {
  id           String     @id @default(cuid())
  campusId     String
  campus       Campus     @relation(fields: [campusId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  allowed      Boolean    @default(true)
  createdAt    DateTime   @default(now())

  @@unique([campusId, permissionId])
  @@index([campusId])
  @@map("campus_permissions")
}

/// ----------------------
/// Core Academic Models
/// ----------------------

model Class {
  id        String   @id @default(cuid())
  name      String
  grade     String
  section   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id])

  teacherId     String?
  teacher       Teacher? @relation("ClassTeacher", fields: [teacherId], references: [id])
  headTeacherId String?
  headTeacher   Teacher? @relation("ClassHeadTeacher", fields: [headTeacherId], references: [id])

  students       Student[]
  classSubjects  ClassSubject[]
  timetableSlots TimetableSlot[]
  examResults    ExamResult[]

  @@index([schoolId])
  @@index([campusId])
  @@map("classes")
}

model Subject {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  classSubjects  ClassSubject[]
  teachers       Teacher[]
  examSubjects   ExamSubject[]
  examResults    ExamResult[]
  timetableSlots TimetableSlot[]

  @@index([schoolId])
  @@map("subjects")
}

model ClassSubject {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  @@index([classId])
  @@index([subjectId])
  @@map("class_subjects")
}

model Teacher {
  id             String   @id @default(cuid())
  teacherId      String   @unique
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  campusId       String?
  campus         Campus?  @relation(fields: [campusId], references: [id])
  qualifications Json?
  joiningDate    DateTime
  salary         Float?
  status         Status   @default(ACTIVE)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subjects       Subject[]
  classes        Class[]         @relation("ClassTeacher")
  classHeadFor   Class[]         @relation("ClassHeadTeacher")
  attendances    Attendance[]
  salaryHistory  Salary[]
  classSubjects  ClassSubject[]
  examSubjects   ExamSubject[]
  timetableSlots TimetableSlot[]

  @@index([schoolId])
  @@index([campusId])
  @@map("teachers")
}

/// ----------------------
/// Family / Parent / Student
/// ----------------------

model Family {
  id               String       @id @default(cuid())
  familyId         String       @unique
  fatherName       String
  motherName       String
  guardianName     String?
  guardianRelation String?
  guardianGender   Gender?
  kidsCount        Int
  nationality      Nationality?
  address          Json
  primaryPhone     String
  secondaryPhone   String?
  email            String?
  whatsapp         String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  students Student[]
  parents  Parent[]

  @@index([primaryPhone])
  @@map("families")
}

model Parent {
  id        String   @id @default(cuid())
  parentId  String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  familyId  String
  family    Family   @relation(fields: [familyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]

  @@index([familyId])
  @@map("parents")
}

model Student {
  id           String       @id @default(cuid())
  studentId    String       @unique
  grNumber     String
  admissionNo  String?
  kidNo        Int?
  studentName  String
  shortName    String?
  dateOfBirth  DateTime?
  gender       Gender
  religion     Religion?
  placeOfBirth String?
  bloodGroup   BloodGroup?
  nationality  Nationality?
  city         String?
  postalCode   Int?
  bFormNumber  String?
  areaName     String?
  address      Json
  phoneNumber  String?
  whatsapp     String?
  email        String?
  status       Status       @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  // Relations
  userId   String  @unique
  user     User?   @relation(fields: [userId], references: [id])
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  campusId String?
  campus   Campus? @relation(fields: [campusId], references: [id])
  familyId String?
  family   Family? @relation(fields: [familyId], references: [id])
  parentId String?
  Parent   Parent? @relation(fields: [parentId], references: [id])

  classId String?
  class   Class?  @relation(fields: [classId], references: [id])

  attendances           Attendance[]
  vouchers              Voucher[]
  payments              Payment[]
  educationHistory      EducationHistory[]
  discountRequests      DiscountRequest[]
  examResults           ExamResult[]
  incomingPayments      IncomingPayment[]
  paymentReconciliation PaymentReconciliation[]

  @@unique([schoolId, grNumber])
  @@index([schoolId])
  @@index([campusId])
  @@index([classId])
  @@index([familyId])
  @@map("students")
}

/// ----------------------
/// Attendance
/// ----------------------

model Attendance {
  id        String           @id @default(cuid())
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // marker info
  markedById String
  markedBy   User    @relation(fields: [markedById], references: [id])
  schoolId   String
  school     School  @relation(fields: [schoolId], references: [id])
  campusId   String?
  campus     Campus? @relation(fields: [campusId], references: [id])

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  @@index([studentId, date])
  @@index([schoolId, date])
  @@index([markedById, date])
  @@map("attendances")
}

/// ----------------------
/// Finance: FeeStructure, Voucher, Payment, Discount
/// ----------------------

model FeeStructure {
  id          String       @id @default(cuid())
  name        String
  amount      Float
  frequency   FeeFrequency
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  schoolId String
  school   School    @relation(fields: [schoolId], references: [id])
  vouchers Voucher[]
  payments Payment[]

  @@index([schoolId])
  @@map("fee_structures")
}

model Voucher {
  id              String        @id @default(cuid())
  voucherNumber   String        @unique
  paymentCode     String        @unique // Unique 6-10 digit code for payment matching
  schoolId        String
  school          School        @relation(fields: [schoolId], references: [id])
  campusId        String?
  campus          Campus?       @relation(fields: [campusId], references: [id])
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  feeStructureId  String?
  feeStructure    FeeStructure? @relation(fields: [feeStructureId], references: [id])
  issueDate       DateTime
  dueDate         DateTime
  month           String? // e.g., "2024-01" for January 2024
  academicYear    String? // e.g., "2024-2025"
  amountExpected  Float
  discountApplied Float         @default(0)
  amountDue       Float
  status          VoucherStatus @default(PENDING)
  createdBy       String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  payments              Payment[]
  incomingPayments      IncomingPayment[]
  paymentReconciliation PaymentReconciliation[]

  @@index([studentId])
  @@index([schoolId, issueDate])
  @@index([voucherNumber])
  @@index([paymentCode])
  @@map("vouchers")
}

model Payment {
  id              String        @id @default(cuid())
  amount          Float
  paymentDate     DateTime
  method          String?
  referenceNumber String?
  status          PaymentStatus
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  voucherId      String
  voucher        Voucher       @relation(fields: [voucherId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  feeStructureId String?
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  schoolId       String
  school         School        @relation(fields: [schoolId], references: [id])

  @@index([voucherId])
  @@index([referenceNumber])
  @@index([studentId])
  @@index([schoolId])
  @@map("payments")
}

model DiscountRequest {
  id              String         @id @default(cuid())
  studentId       String
  student         Student        @relation(fields: [studentId], references: [id])
  requestedBy     String
  requestedAmount Float
  reason          String
  status          DiscountStatus @default(PENDING)
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id])

  @@index([studentId])
  @@index([requestedBy])
  @@index([schoolId])
  @@map("discount_requests")
}

/// ----------------------
/// Automated Fee Reconciliation System
/// ----------------------

model IncomingPayment {
  id                String      @id @default(cuid())
  schoolId          String
  school            School      @relation(fields: [schoolId], references: [id])
  bankReference     String // Bank transaction reference/ID
  transactionDate   DateTime
  amount            Float
  accountHolderName String? // Name on the bank account
  remarks           String? // Payment note/message from bank
  rawData           Json? // Store original bank statement row
  matchStatus       MatchStatus @default(UNMATCHED)
  matchedAt         DateTime?
  matchedBy         String? // User ID who performed manual match
  extractedCode     String? // Payment code extracted from remarks
  voucherId         String? // Matched voucher
  voucher           Voucher?    @relation(fields: [voucherId], references: [id])
  studentId         String? // Matched student
  student           Student?    @relation(fields: [studentId], references: [id])
  importBatchId     String? // Group imports together
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  reconciliations PaymentReconciliation[]

  @@unique([schoolId, bankReference])
  @@index([schoolId, matchStatus])
  @@index([voucherId])
  @@index([studentId])
  @@index([extractedCode])
  @@index([importBatchId])
  @@map("incoming_payments")
}

model PaymentReconciliation {
  id                String          @id @default(cuid())
  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id])
  incomingPaymentId String
  incomingPayment   IncomingPayment @relation(fields: [incomingPaymentId], references: [id])
  voucherId         String
  voucher           Voucher         @relation(fields: [voucherId], references: [id])
  studentId         String
  student           Student         @relation(fields: [studentId], references: [id])
  matchType         MatchType // AUTO or MANUAL
  matchConfidence   Float? // 0-100 for auto matches
  amountMatched     Float
  discrepancy       Float           @default(0) // If amounts don't match exactly
  notes             String?
  reconciledBy      String? // User ID for manual reconciliation
  reconciledAt      DateTime        @default(now())
  createdAt         DateTime        @default(now())

  @@index([schoolId])
  @@index([incomingPaymentId])
  @@index([voucherId])
  @@index([studentId])
  @@map("payment_reconciliations")
}

model StudentAdmission {
  id                String          @id @default(cuid())
  admissionNo       String?         @unique
  inquiryNo         String?         @unique
  studentName       String
  fatherName        String
  motherName        String
  dateOfBirth       DateTime?
  gender            Gender
  religion          Religion?
  nationality       Nationality?
  address           Json
  phoneNumber       String
  email             String?
  previousSchool    String?
  previousClass     String?
  classAppliedFor   String
  status            AdmissionStatus @default(INQUIRY)
  submittedBy       String // User ID (teacher, admission officer, etc.)
  submittedByRole   Role
  reviewedBy        String? // User ID (principal, admission manager)
  reviewedAt        DateTime?
  rejectionReason   String?
  grNumber          String? // Generated on approval
  enrolledStudentId String? // Link to Student model after enrollment
  schoolId          String
  school            School          @relation(fields: [schoolId], references: [id])
  campusId          String?
  campus            Campus?         @relation(fields: [campusId], references: [id])
  documents         Json? // Store document URLs
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([schoolId])
  @@index([campusId])
  @@index([status])
  @@index([submittedBy])
  @@index([grNumber])
  @@map("student_admissions")
}

/// ----------------------
/// Staff compensation
/// ----------------------

model Salary {
  id          String   @id @default(cuid())
  amount      Float
  paymentDate DateTime
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])

  @@index([userId])
  @@index([schoolId])
  @@map("salaries")
}

/// ----------------------
/// Audit / Logging
/// ----------------------

model AuditLog {
  id              String   @id @default(cuid())
  entityType      String
  entityId        String
  action          String
  performedBy     String?
  performedByUser User?    @relation("performedBy", fields: [performedBy], references: [id])
  performedAt     DateTime @default(now())
  before          Json?
  after           Json?
  note            String?
  schoolId        String?
  school          School?  @relation(fields: [schoolId], references: [id])

  @@index([entityType, entityId])
  @@index([performedBy, performedAt])
  @@index([schoolId])
  @@map("audit_logs")
}

/// ----------------------
/// Education / History
/// ----------------------

model EducationHistory {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  institution String
  degree      String
  year        Int
  grade       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@map("education_histories")
}

/// ----------------------
/// Bank details, experience, qualification
/// ----------------------

model BankDetail {
  id            String   @id @default(cuid())
  bankName      String
  accountTitle  String
  accountNumber String
  iban          String?
  branchCode    String?
  branchAddress String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId   String? @unique
  user     User?   @relation(fields: [userId], references: [id])
  schoolId String? @unique
  school   School? @relation(fields: [schoolId], references: [id])

  @@index([accountNumber])
  @@index([iban])
  @@map("bank_details")
}

/// ----------------------
/// Future modules: Exams, Timetable, Library, Inventory, Transport, Notifications, OnlineClass
/// ----------------------

model Exam {
  id        String    @id @default(cuid())
  name      String
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id])
  campusId  String?
  campus    Campus?   @relation(fields: [campusId], references: [id])
  startDate DateTime
  endDate   DateTime?
  published Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  subjects ExamSubject[]
  results  ExamResult[]

  @@index([schoolId])
  @@index([campusId])
  @@map("exams")
}

model ExamSubject {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  maxMarks  Int
  createdAt DateTime @default(now())

  @@index([examId])
  @@index([subjectId])
  @@map("exam_subjects")
}

model ExamResult {
  id            String   @id @default(cuid())
  examId        String
  exam          Exam     @relation(fields: [examId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  classId       String?
  class         Class?   @relation(fields: [classId], references: [id])
  marksObtained Float
  remarks       String?
  createdAt     DateTime @default(now())

  @@index([examId, studentId])
  @@index([subjectId])
  @@map("exam_results")
}

/// Timetable (simple)
model TimetableSlot {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  campusId  String?
  campus    Campus?  @relation(fields: [campusId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacherId String?
  teacher   Teacher? @relation(fields: [teacherId], references: [id])
  dayOfWeek Int
  startTime String
  endTime   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([classId, dayOfWeek, startTime])
  @@index([schoolId])
  @@index([campusId])
  @@map("timetable_slots")
}

/// Simple library model
model LibraryItem {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  title     String
  author    String?
  isbn      String?
  copies    Int      @default(1)
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@map("library_items")
}

/// Inventory
model InventoryItem {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  category  String?
  qty       Int      @default(0)
  unit      String?
  createdAt DateTime @default(now())

  @@index([schoolId])
  @@map("inventory_items")
}

/// Transport
model TransportVehicle {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id])
  vehicleNo  String
  driverName String?
  capacity   Int?
  contact    String?
  createdAt  DateTime @default(now())

  routes TransportRoute[]

  @@index([schoolId])
  @@map("transport_vehicles")
}

model TransportRoute {
  id         String           @id @default(cuid())
  schoolId   String
  school     School           @relation(fields: [schoolId], references: [id])
  vehicleId  String
  vehicle    TransportVehicle @relation(fields: [vehicleId], references: [id])
  startPoint String
  endPoint   String
  stops      Json?
  createdAt  DateTime         @default(now())

  @@index([schoolId])
  @@map("transport_routes")
}

/// Notifications (server jobs write these and worker pushes via WhatsApp/Email)
model Notification {
  id        String    @id @default(cuid())
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id])
  campusId  String?
  campus    Campus?   @relation(fields: [campusId], references: [id])
  title     String
  message   String
  channel   String
  meta      Json?
  status    String    @default("pending")
  createdAt DateTime  @default(now())
  sentAt    DateTime?

  @@index([schoolId, status])
  @@index([campusId])
  @@map("notifications")
}

/// Online / virtual classes (future)
model OnlineClass {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id])
  campusId    String?
  campus      Campus?   @relation(fields: [campusId], references: [id])
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  meetingUrl  String?
  createdAt   DateTime  @default(now())

  @@index([schoolId])
  @@index([campusId])
  @@map("online_classes")
}

/// ----------------------
/// Role-specific helper tables (unique relations)
/// ----------------------

model SchoolAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("school_admins")
}

